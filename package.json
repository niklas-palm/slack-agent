    "@aws/bedrock-token-generator": "^1.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@smithy/signature-v4": "^5.4.0",
    "@strands-agents/sdk": "^1.17.0",
    "bedrock-agentcore": "^0.4.3",
    "openai": "^6.49.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.7.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
