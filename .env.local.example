# Copy to .env.local for local container dev (`make up`). Git-ignored.
# Region, model and feature switches come from config.json, not from here.

# Local Slack: point at the mock server in docker-compose instead of api.slack.com.
# The mock server does not check the token, so any non-empty value works. Kept
# free of the real `xoxb-` prefix so secret scanners don't flag this file.
SLACK_BOT_TOKEN=local-mock-token
SLACK_API_BASE=http://mock-slack:8090/api
